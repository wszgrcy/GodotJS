    # 运行时要在可执行文件旁边找到它（或用环境变量 GODOTJS_ICU_DATA 指到具体文件）。
    # 这里顺手拷一份到 bin/，本地跑引擎就能直接用；导出游戏时由导出预设把同一个文件带进产物，
    # macOS 的 .app 与 iOS/Android 的包体同理（放不进可执行文件旁边时就用 GODOTJS_ICU_DATA）。
    icu_data_src = f"v8/{v8_basename}/icudtl.dat"
    icu_data_dst = os.path.join(env.Dir("#bin").abspath, "icudtl.dat")
    if os.path.exists(icu_data_src):
        os.makedirs(os.path.dirname(icu_data_dst), exist_ok=True)
        shutil.copyfile(icu_data_src, icu_data_dst)

    if jsb_platform == "macos":
        env.Append(LIBPATH=[f'#modules/{module_name}/v8/{v8_basename}'])
        env.Append(LINKFLAGS=["-lv8_monolith"])
    elif jsb_platform in ["linux", "windows", "android", "ios"]:
        env.Append(LIBS=[File(v8_lib_path)])
    else:
        check(False, f'v8 is not supported on {env["platform"]}')

    # V8 15.x headers demand C++20 (include/v8config.h errors out on anything
    # older). Godot prepends `-std=gnu++17` / `/std:c++17` in SConstruct, so the
    # module has to override it for its own sources.
    if env.msvc:
        # two /std: flags would fight each other, so drop the engine's one first
        if "/std:c++17" in env_jsb["CXXFLAGS"]:
            env_jsb["CXXFLAGS"].remove("/std:c++17")
        env_jsb.Append(CXXFLAGS=["/std:c++20"])
    else:
        # appended, so it wins over the prepended -std=gnu++17
        env_jsb.Append(CXXFLAGS=["-std=gnu++20"])

    # V8 15.x performs 128-bit compare-and-swap on objects that are only 8 bytes
    # aligned, so the compiler emits calls to the generic __atomic_* helpers
    # instead of a `cmpxchg16b` instruction. Those live in libatomic, which is not
    # part of the monolith. Apple toolchains do not ship libatomic, so they are
    # left alone until a build proves they need it.
    if jsb_platform in ["linux", "android"] and not env.msvc:
        env.Append(LIBS=["atomic"])

    # platform-specific defines
    if jsb_platform == "windows":
        env.Append(LINKFLAGS=["winmm.lib", "Dbghelp.lib"])
    if jsb_platform not in ["ios", "android"]:
        env_jsb.AppendUnique(CPPDEFINES=["V8_COMPRESS_POINTERS"])

    # env_jsb.AppendUnique(CPPDEFINES=["V8_ENABLE_TURBOFAN"])
    env_jsb.AppendUnique(CPPDEFINES=["_ITERATOR_DEBUG_LEVEL=0"])

    # headers
    env_jsb.Append(CPPPATH=[f"#modules/{module_name}/v8/include"])
    env_jsb.Append(CPPPATH=["v8/include"])
