# Where to look for the prebuilt archives before reaching out to `deps_url`.
# The 15.x packages are produced by a checkout of GodotJS-Dependencies; while
# they are not published to a release yet, point that checkout's `dist/`
# directory here and the build reads the zip straight off the disk:
#   GODOTJS_DEPS_DIR=/path/to/GodotJS-Dependencies/dist scons ...
# Otherwise a checkout sitting next to the engine source is picked up, and if
# neither exists the archive is downloaded from `deps_url` as before.
def _find_local_deps_dir():
    candidates = [os.environ.get("GODOTJS_DEPS_DIR", "")]
    candidates += [
        os.path.join(module_path, "..", "..", "GodotJS-Dependencies", "dist"),
        os.path.join(module_path, "..", "GodotJS-Dependencies", "dist"),
    ]
    for candidate in candidates:
        if candidate and os.path.isdir(candidate):
            return os.path.abspath(candidate)
    return ""

