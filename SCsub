def check(condition, text):
    '''Directly fail the build if the condition is not met'''
    if not condition:
        print_error(text)
        Exit(2)

def is_library_supported(support):
    for details in support.details:
        if jsb_platform == details.platform and jsb_arch == details.arch:
            return True
    return False

# def validate_library_support(support: LibraryDescriptor) -> tuple[LibraryDescriptor, LibraryDetails]:
def validate_library_support(support):
    for details in support.details:
        if jsb_platform != details.platform or jsb_arch != details.arch:
            continue
        libpath = support.name + "/" \
                  + details.platform_base() + "/" \
                  + details.libname
        if os.path.exists(libpath):
            return (support, details)
    return None

# def read_macro_value(name: str, def_val = None):
def read_macro_value(name, def_val = None):
    with open("jsb.config.h", "rt", encoding="utf-8") as input:
        regex = rf"^#define\s+{name}\s+(\d+)$"
        for line in input:
            matches = re.finditer(regex, line)
            for _, match in enumerate(matches, start=1):
                return match.group(1)
    if def_val is not None:
        return def_val
    raise ValueError(f"no {name} defined in jsb.config.h")

def download_dependency(name, version, target_dir):
    '''Installs a prebuilt dependency if the target directory does not exist.'''
    if os.path.exists(target_dir):
        return

    filename = f"{name}_{version}.zip"
    url = f"{deps_url}/download/{deps_release_tag}/{filename}"
    local_path = os.path.join(deps_local_dir, filename) if deps_local_dir else ""

    print_info(f"Dependency '{name}' not found at '{target_dir}'.")

    try:
        if local_path and os.path.isfile(local_path):
            print_info(f"Using {local_path} ...")
            archive = local_path
        else:
            print_info(f"Downloading {filename} from {url} ...")
            urllib.request.urlretrieve(url, filename)
            archive = filename

        print_info(f"Extracting {filename} ...")
        with zipfile.ZipFile(archive, 'r') as zip_ref:
            zip_ref.extractall(".")

        if archive == filename and os.path.exists(filename):
            os.remove(filename)

        if not os.path.exists(target_dir):
            check(False, f"Extraction failed: Directory '{target_dir}' was not created.")

        print_info(f"Successfully installed {name}.")

    except Exception as e:
        check(False, f"Failed to download or extract {name}: {str(e)}")

